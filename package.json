{
  "name": "tu-amigo-viajero",
  "version": "3.2.0",
  "private": true,
  "description": "Comparador de precios de vuelos, hoteles y paquetes: los 3 resultados más baratos de cada plataforma en una sola búsqueda, en Colombia y el exterior.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tav/web",
    "dev:api": "npm run dev -w @tav/api",
    "build": "npm run build -w @tav/web",
    "preview": "npm run preview -w @tav/web",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "activar": "node scripts/activar.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
